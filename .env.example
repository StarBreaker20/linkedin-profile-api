# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn session (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
# Obtain these by logging into linkedin.com in a browser, then copying the
# cookies from DevTools → Application → Cookies → https://www.linkedin.com.
# See docs/CAPTURE_RECIPE.md for step-by-step instructions.
#
#   li_at       -> the authentication token (long opaque string)
#   JSESSIONID  -> looks like "ajax:1234567890123456789"; the CSRF token is
#                  this value with the surrounding quotes stripped.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID="ajax:0000000000000000000"

# ─────────────────────────────────────────────────────────────────────────────
# Outbound network
# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn blocks most datacenter IPs. In production, route requests through a
# residential/mobile proxy (e.g. http://user:pass@host:port). Leave blank for
# local development on a residential connection.
OUTBOUND_PROXY_URL=

# ─────────────────────────────────────────────────────────────────────────────
# API server
# ─────────────────────────────────────────────────────────────────────────────
# Optional API key to protect YOUR public endpoint. If set, clients must send
# it in the `X-API-Key` header. Leave blank to disable auth.
API_KEY=

# Politeness budget: max requests/minute this service will make toward LinkedIn.
LINKEDIN_MAX_RPM=8

# Per-profile response cache TTL in seconds (0 disables caching).
CACHE_TTL_SECONDS=3600

# Comma-separated CORS origins (* allows any).
CORS_ORIGINS=*

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
